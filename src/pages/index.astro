---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Дизайнер Марк Пурель">
  <main class="font-onest bg-black">
    <Hero />
  </main>
</Layout>

<script>
  import ChatGPTTyper from '../scripts/ChatGPTTyper';
  import gsap from 'gsap';

  window.addEventListener('DOMContentLoaded', () => {
    
    // 1. Инициализируем тайперы ДО анимации с флагом startOnView: false.
    // Они сразу заменят текст на прозрачные спаны, предотвращая мигание.
    const titleTypers = Array.from(document.querySelectorAll('.typing-title')).map(
      el => new ChatGPTTyper(el, { speed: 40, tail: 2, finalColor: "#ffffff", tailColor: "#ff7b00", startOnView: false })
    );
    
    const descTypers = Array.from(document.querySelectorAll('.typing-text')).map(
      el => new ChatGPTTyper(el, { speed: 25, tail: 4, finalColor: "#ffffff", tailColor: "#ff7b00", startOnView: false })
    );

    // 2. Запускаем GSAP анимацию
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.from('.ui-header', { opacity: 0, y: -20, duration: 1 }, 0)
      .from('.anim-render', { opacity: 0, scale: 0.95, duration: 1.5 }, 0.2)
      .from('.anim-title', { opacity: 0, y: 30, duration: 1.2 }, 0.4)
      .from('.anim-avatar', { opacity: 0, y: 20, duration: 1 }, 0.8)
      // 3. Вызываем ручной старт печати после появления блоков
      .call(() => {
        titleTypers.forEach(typer => typer.start());
        descTypers.forEach(typer => typer.start());
      });
      
  });
</script>