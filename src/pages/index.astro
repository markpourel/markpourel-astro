---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Дизайнер Марк Пурель">
  <main class="font-onest bg-black">
    <Hero />
  </main>
</Layout>

<script>
  import ChatGPTTyper from '../scripts/ChatGPTTyper';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    
    // --- 1. Тайперы и появление элементов ---
    const titleTypers = Array.from(document.querySelectorAll('.typing-title')).map(
      el => new ChatGPTTyper(el, { speed: 40, tail: 2, finalColor: "#ffffff", tailColor: "#ff7b00", startOnView: false })
    );
    const descTypers = Array.from(document.querySelectorAll('.typing-text')).map(
      el => new ChatGPTTyper(el, { speed: 25, tail: 4, finalColor: "#ffffff", tailColor: "#ff7b00", startOnView: false })
    );

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.from('.anim-render', { opacity: 0, scale: 0.95, duration: 1.5 }, 0)
      .from('.anim-avatar', { opacity: 0, y: 20, duration: 1 }, 0.4)
      .from('.anim-timeline', { opacity: 0, y: 20, duration: 1 }, 1.2)
      .from('.ui-header', { opacity: 0, y: -20, duration: 1 }, 1.2)
      .call(() => { titleTypers.forEach(typer => typer.start()); }, null, 0.2)
      .call(() => { descTypers.forEach(typer => typer.start()); }, null, 0.4);

    // --- 2. Умная логика видео при скролле ---
    const video = document.querySelector('.anim-render') as HTMLVideoElement;
    const heroSection = document.querySelector('.hero-section');
    const timelineFill = document.querySelector('.timeline-fill');
    const timelineThumb = document.querySelector('.timeline-thumb');
    
    if (!video || !heroSection) return;

    let isScrolled = false;

    video.muted = true;
    video.loop = true; 
    video.setAttribute('playsinline', '');
    
    // Функция безопасного старта видео
    const startVideoPlay = async () => {
      try {
        await video.play();
      } catch (e) {
        console.log('Автоплей заблокирован браузером:', e);
      }
    };

    // Ждем, пока браузер скачает достаточно данных для игры без тормозов
    if (video.readyState >= 4) { // 4 = HAVE_ENOUGH_DATA
      startVideoPlay();
    } else {
      video.addEventListener('canplaythrough', startVideoPlay, { once: true });
    }

    video.addEventListener('timeupdate', () => {
      if (!isScrolled && video.currentTime >= 4) {
        video.currentTime = 0;
      }
    });

    const initScrollVideo = () => {
      const videoDuration = (isFinite(video.duration) && video.duration > 0) ? video.duration : 10; 
      const startLoopTime = Math.min(4, videoDuration - 0.1); 

      ScrollTrigger.create({
        trigger: heroSection,
        start: "top top",
        end: "+=250%", 
        pin: true,
        onUpdate: (self) => {
          if (self.progress > 0.001) {
            isScrolled = true;
            video.pause(); 
            
            // 1. Анимируем видео
            gsap.to(video, {
              currentTime: startLoopTime + (self.progress * (videoDuration - startLoopTime)),
              duration: 0.1, 
              ease: "none",
              overwrite: "auto" 
            });

            // 2. Анимируем интерфейс таймлайна
            const progressPercent = self.progress * 100;
            if (timelineFill && timelineThumb) {
              gsap.to(timelineFill, { width: `${progressPercent}%`, duration: 0.1, ease: "none", overwrite: "auto" });
              gsap.to(timelineThumb, { left: `${progressPercent}%`, duration: 0.1, ease: "none", overwrite: "auto" });
            }

          } else {
            isScrolled = false;
            startVideoPlay(); // Безопасный старт при возврате в начало
            
            // Сбрасываем таймлайн в 0
            if (timelineFill && timelineThumb) {
              gsap.to(timelineFill, { width: `0%`, duration: 0.3, ease: "power2.out", overwrite: "auto" });
              gsap.to(timelineThumb, { left: `0%`, duration: 0.3, ease: "power2.out", overwrite: "auto" });
            }
          }
        }
      });
    };

    // Инициализируем скролл только когда известна длительность видео
    if (video.readyState >= 1) { // 1 = HAVE_METADATA 
      initScrollVideo();
    } else {
      video.addEventListener('loadedmetadata', initScrollVideo);
    }
  });
</script>