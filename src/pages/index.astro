---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profileImg from '../assets/profile/profile.jpg'; 

const projectFiles = Object.keys(import.meta.glob('/public/projects/*.jpg'));
const projects = projectFiles.map(path => path.replace('/public', ''));
---

<Layout title="Марк Пурель | Диджитал-дизайнер">
  <header class="sticky top-0 z-50 w-full border-b border-neutral-900 bg-[#050505]/90 backdrop-blur-md">
    <div class="mx-auto max-w-[1440px] px-8">
      <div class="flex h-20 items-center justify-between">
        <a href="/" class="transition-opacity hover:opacity-80">
          <img src="/icons/logo.svg" alt="P Logo" class="h-10 w-10" />
        </a>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-[1440px] px-8 py-10 overflow-hidden">
    <section class="mb-12">
      <div class="stage" id="stage">
        <div class="stack" id="stack"></div>
        <div class="hit-layer" id="hitLayer"></div>
      </div>
    </section>

    <section class="flex flex-row items-start justify-between gap-12 border-t border-neutral-900 pt-8">
      <div class="flex items-center gap-5">
        <div class="h-20 w-[80px] shrink-0 overflow-hidden rounded-2xl bg-neutral-900">
          <Image src={profileImg} alt="Марк Пурель" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
        </div>
        <div>
          <p class="text-xs font-medium text-neutral-500">Марк Пурель</p>
          <h1 class="mt-0.5 text-xl font-bold text-white">Диджитал-дизайнер</h1>
          <p class="mt-2 text-xs leading-relaxed text-neutral-400 max-w-[200px]">Закрываю весь цикл продакшена: UX/UI, 3D, Моушн и AI</p>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-x-12 gap-y-4">
        <div class="flex flex-col gap-y-3">
          <div class="flex items-center gap-2"><img src="/icons/figma.svg" alt="" class="h-5 w-5" /><span class="text-xs text-neutral-400">Figma</span></div>
          <div class="flex items-center gap-2"><img src="/icons/illustrator.svg" alt="" class="h-5 w-5" /><span class="text-xs text-neutral-400">Illustrator</span></div>
          <div class="flex items-center gap-2"><img src="/icons/redshift.svg" alt="" class="h-5 w-5" /><span class="text-xs text-neutral-400">Redshift</span></div>
        </div>
        <div class="flex flex-col gap-y-3">
          <div class="flex items-center gap-2"><img src="/icons/tilda.svg" alt="" class="h-5 w-5" /><span class="text-xs text-neutral-400">Tilda</span></div>
          <div class="flex items-center gap-2"><img src="/icons/after.svg" alt="" class="h-5 w-5" /><span class="text-xs text-neutral-400">After Effects</span></div>
          <div class="flex items-center gap-2"><img src="/icons/comfy.svg" alt="" class="h-5 w-5" /><span class="text-xs text-neutral-400">ComfyUI</span></div>
        </div>
        <div class="flex flex-col gap-y-3">
          <div class="flex items-center gap-2"><img src="/icons/photoshop.svg" alt="" class="h-5 w-5" /><span class="text-xs text-neutral-400">Photoshop</span></div>
          <div class="flex items-center gap-2"><img src="/icons/3dsmax.svg" alt="" class="h-5 w-5" /><span class="text-xs text-neutral-400">3dsMax</span></div>
          <div class="flex items-center gap-2"><img src="/icons/flow.svg" alt="" class="h-5 w-5" /><span class="text-xs text-neutral-400">Google Flow</span></div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  :root { --card-h: clamp(240px, 20vw, 360px); --stage-h: calc(var(--card-h) + 12px); }
  .stage { position: relative; width: 100%; height: var(--stage-h); overflow: visible; opacity: 0; transform: translateY(14px); transition: opacity .7s ease, transform .7s ease; }
  html.ui-ready .stage { opacity: 1; transform: translateY(0); }
  .stack { position: absolute; inset: 0; z-index: 1; overflow: visible; }
  .hit-layer { position: absolute; inset: 0; z-index: 900; cursor: grab; }
  .card { position: absolute; left: 0; top: 0; height: var(--card-h); background: #1a1a1a; padding: 8px; border-radius: 16px; box-shadow: 0 12px 32px rgba(0,0,0,.5); will-change: transform; transform-origin: center center; cursor: pointer; pointer-events: none; }
  .card-img { width: 100%; height: 100%; border-radius: 10px; background-size: cover; background-position: center; background-color: #050505; position: relative; overflow: hidden; }
  .hover-anim { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.4s; border-radius: inherit; pointer-events: none; }
  @media (hover: hover) { .card.is-active .hover-anim { opacity: 1; } }
</style>

<script define:vars={{ projects }}>
  (function () {
    const stack = document.getElementById('stack'), hitLayer = document.getElementById('hitLayer'), stage = document.getElementById('stage');
    let ITEMS = projects.map(src => ({ src, ratio: 1 }));
    
    function start(items) {
      let active = -1, pointer = { inside: false }, mobileOffset = 0, lastTime = performance.now();
      let cards = items.map((item, i) => {
        let el = document.createElement('article'); el.className = 'card';
        let inner = document.createElement('div'); inner.className = 'card-img'; inner.style.backgroundImage = 'url("' + item.src + '")';
        let hover = document.createElement('img'); hover.className = 'hover-anim'; hover.src = item.src.replace(/\.jpg$/i, '.webp'); hover.alt = '';
        inner.appendChild(hover); el.appendChild(inner); stack.appendChild(el);
        return { el, ratio: item.ratio, x: 0, y: 0, s: 1, vx: 0, vy: 0, vs: 0, tx: 0, ty: 0, ts: 1 };
      });
      function render(now) {
        let dt = Math.max(0.5, Math.min(2.15, (now - lastTime) / 16.6667)); lastTime = now;
        let cardH = stage.offsetHeight || 300, curX = mobileOffset;
        cards.forEach((c, i) => {
          let w = cardH * c.ratio;
          c.el.style.width = w + 'px'; c.el.style.height = cardH + 'px';
          c.tx = curX; c.ty = (active === i && pointer.inside) ? -cardH * 0.03 : 0; c.ts = (active === i && pointer.inside) ? 1.02 : 1;
          curX += w + 24;
          c.vx += (c.tx - c.x) * .09 * dt; c.vx *= Math.pow(.735, dt); c.x += c.vx * dt;
          c.vy += (c.ty - c.y) * .08 * dt; c.vy *= Math.pow(.728, dt); c.y += c.vy * dt;
          c.vs += (c.ts - c.s) * .07 * dt; c.vs *= Math.pow(.77, dt); c.s += c.vs * dt;
          c.el.style.transform = `translate(${c.x.toFixed(2)}px, ${c.y.toFixed(2)}px) scale(${c.s.toFixed(3)})`;
          if (active === i && pointer.inside) c.el.classList.add('is-active'); else c.el.classList.remove('is-active');
        });
        requestAnimationFrame(render);
      }
      hitLayer.addEventListener('pointermove', e => {
        let rect = stage.getBoundingClientRect(), lx = e.clientX - rect.left;
        active = -1; let cur = mobileOffset;
        cards.forEach((c, i) => { let w = (stage.offsetHeight || 300) * c.ratio; if(lx >= c.x && lx <= c.x + w) active = i; cur += w + 24; });
        pointer.inside = true;
      });
      hitLayer.addEventListener('wheel', e => { e.preventDefault(); mobileOffset -= e.deltaX * 1.2; }, { passive: false });
      requestAnimationFrame(render);
      document.documentElement.classList.add('ui-ready');
    }
    Promise.all(ITEMS.map(item => new Promise(res => {
      let img = new Image(); img.onload = () => { item.ratio = Math.max(0.4, Math.min(3.0, img.naturalWidth / img.naturalHeight)); res(); };
      img.src = item.src;
    }))).then(() => start(ITEMS));
  })();
</script>