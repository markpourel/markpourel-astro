---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Дизайнер Марк Пурель">
  <main class="font-onest bg-black">
    <Hero />
  </main>
</Layout>

<script>
  import ChatGPTTyper from '../scripts/ChatGPTTyper';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    
    // --- 1. Тайперы и появление элементов ---
    const titleTypers = Array.from(document.querySelectorAll('.typing-title')).map(
      el => new ChatGPTTyper(el, { speed: 40, tail: 2, finalColor: "#ffffff", tailColor: "#ff7b00", startOnView: false })
    );
    const descTypers = Array.from(document.querySelectorAll('.typing-text')).map(
      el => new ChatGPTTyper(el, { speed: 25, tail: 4, finalColor: "#ffffff", tailColor: "#ff7b00", startOnView: false })
    );

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.from('.anim-render', { opacity: 0, scale: 0.95, duration: 1.5 }, 0)
      .from('.anim-avatar', { opacity: 0, y: 20, duration: 1 }, 0.4)
      .from('.anim-timeline', { opacity: 0, y: 20, duration: 1 }, 1.2)
      .from('.ui-header', { opacity: 0, y: -20, duration: 1 }, 1.2)
      .call(() => { titleTypers.forEach(typer => typer.start()); }, null, 0.2)
      .call(() => { descTypers.forEach(typer => typer.start()); }, null, 0.4);

    // --- 2. Логика Canvas Image Sequence ---
    const canvas = document.querySelector('.anim-render') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');
    const heroSection = document.querySelector('.hero-section');
    const timelineFill = document.querySelector('.timeline-fill');
    const timelineThumb = document.querySelector('.timeline-thumb');
    
    if (!canvas || !ctx || !heroSection) return;

    // Указываем разрешение исходных кадров
    canvas.width = 1920; 
    canvas.height = 1080;

    // ВАЖНО: Укажи здесь точное количество кадров, которое выдал FFmpeg!
    const frameCount = 421; 
    // 4 секунды * 30 fps = 120 кадр (точка зацикливания и начала скролла)
    const loopEndFrame = 120; 

    const images: HTMLImageElement[] = [];
    const frames = { currentIndex: 0 };

    // Генератор путей к кадрам (frame_0001.jpg, frame_0002.jpg...)
    const currentFrame = (index: number) => `/frames/frame_${(index + 1).toString().padStart(4, '0')}.jpg`;

    // Функция отрисовки кадра
    const render = () => {
      const img = images[Math.round(frames.currentIndex)];
      if (img && img.complete) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      }
    };

    // Предзагрузка всех кадров
    for (let i = 0; i < frameCount; i++) {
      const img = new Image();
      img.src = currentFrame(i);
      images.push(img);
    }

    // Рисуем самый первый кадр сразу, как только он загрузится
    images[0].onload = render;

    // Создаем анимацию холостого хода (0 - 4 сек), которая крутится бесконечно
    let idleAnimation = gsap.to(frames, {
      currentIndex: loopEndFrame,
      duration: 4, // 4 секунды реального времени
      ease: "none",
      repeat: -1, // Бесконечный повтор
      onUpdate: render
    });

    // Привязываем остальные кадры к скроллу
    ScrollTrigger.create({
      trigger: heroSection,
      start: "top top",
      end: "+=250%", 
      pin: true,
      onUpdate: (self) => {
        if (self.progress > 0.001) {
          // Пользователь начал скроллить — ставим холостой ход на паузу
          idleAnimation.pause();
          
          // Анимируем кадры от loopEndFrame до самого конца
          gsap.to(frames, {
            currentIndex: loopEndFrame + (self.progress * (frameCount - 1 - loopEndFrame)),
            duration: 0.1, 
            ease: "none",
            overwrite: "auto",
            onUpdate: render
          });

          // Анимируем интерфейс таймлайна
          const progressPercent = self.progress * 100;
          if (timelineFill && timelineThumb) {
            gsap.to(timelineFill, { width: `${progressPercent}%`, duration: 0.1, ease: "none", overwrite: "auto" });
            gsap.to(timelineThumb, { left: `${progressPercent}%`, duration: 0.1, ease: "none", overwrite: "auto" });
          }

        } else {
          // Пользователь вернулся в самый верх — запускаем холостой ход заново с 0 кадра
          idleAnimation.play(0); 
          
          if (timelineFill && timelineThumb) {
            gsap.to(timelineFill, { width: `0%`, duration: 0.3, ease: "power2.out", overwrite: "auto" });
            gsap.to(timelineThumb, { left: `0%`, duration: 0.3, ease: "power2.out", overwrite: "auto" });
          }
        }
      }
    });

  });
</script>