---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const projectFiles = Object.keys(import.meta.glob('/public/projects/*.{jpg,jpeg,png,webp}'));
let projects = projectFiles.map(path => path.replace('/public', ''));

if (projects.length === 0) {
  projects = [
    'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1000&auto=format&fit=crop',
    'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1000&auto=format&fit=crop',
  ];
}
---

<Layout title="Марк Пурель | Диджитал-дизайнер">
  <!-- Основной контейнер 100vh: Паддинги 32px фиксированы, всё внутри тянется -->
  <div class="mx-auto flex h-dvh w-full max-w-[3840px] flex-col p-[32px] gap-[32px] relative overflow-hidden bg-[#000000] box-border">
    
    <Header />

    <!-- СЦЕНА КЕЙСОВ -->
    <main class="relative w-full flex-1 min-h-0 shrink-0" id="stage">
      <div class="stack" id="stack"></div>
      <div class="hit-layer" id="hitLayer"></div>
    </main>

    <Footer />
   
  </div>
</Layout>

<style is:global>
  /* Физика и стили карточек без изменений */
  .stage { opacity: 0; transform: translateY(14px); transition: opacity .7s ease, transform .7s ease; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  html.ui-ready .stage { opacity: 1; transform: translateY(0); }
  .stack { position: absolute; inset: 0; z-index: 1; overflow: visible; }
  .hit-layer { position: absolute; inset: 0; z-index: 900; cursor: grab; touch-action: pan-y; }
  .hit-layer.is-dragging { cursor: grabbing; }

  .card { position: absolute; left: 0; top: 0; background: #3A3A3A; border-radius: 0.5rem; padding: 0px; box-sizing: border-box; will-change: transform; transform-origin: center center; cursor: pointer; pointer-events: none; }
  .card-img { width: 100%; height: 100%; border-radius: 0.5rem; background-size: cover; background-position: center; position: relative; overflow: hidden; }
  .hover-anim { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1); border-radius: inherit; pointer-events: none; }
  @media (hover: hover) { .card.is-active .hover-anim { opacity: 1; } }

  .gallery-overlay { position: fixed; inset: 0; z-index: 2000; opacity: 0; background: rgba(5, 5, 5, .8); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
  .gallery-clone { position: fixed; z-index: 2001; cursor: zoom-out; background: #3A3A3A; padding: 0px; border-radius: 0.5rem; box-shadow: 0 28px 68px rgba(0,0,0,.8); will-change: left, top, width, height, transform; }
  .gallery-close { position: fixed; right: 2rem; top: 2rem; z-index: 2002; width: 3rem; height: 3rem; border: 0; border-radius: 50%; background: rgba(255,255,255,.1); color: #fff; box-shadow: 0 10px 30px rgba(0,0,0,.5); font-size: 2rem; cursor: pointer; opacity: 0; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(10px); transition: background 0.2s; }
  .gallery-close:hover { background: rgba(255,255,255,.2); }
  body.modal-open { overflow: hidden; }
</style>

<script define:vars={{ projects }}>
  (function () {
    'use strict';
    const SETTINGS = { desktopWheelSensitivity: 1.2, spring: { xStiffness: .090, xDamping: .735, yStiffness: .088, yDamping: .728, scaleStiffness: .076, scaleDamping: .770 } };
    const stack = document.getElementById('stack'); const hitLayer = document.getElementById('hitLayer'); const stage = document.getElementById('stage');
    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let modal = { open: false, animating: false, index: -1, overlay: null, clone: null, closeBtn: null, hiddenCard: null };
    let ITEMS = projects.map(src => ({ src }));
    if (!ITEMS.length || !stack || !stage || !hitLayer) return;
    startGallery();

    function startGallery() {
      let active = -1; let pointer = { x: 0, y: 0, inside: false }; let lastTime = performance.now(); let mobileOffset = 0; let mobileTargetOffset = 0; let mobileVelocity = 0; let drag = { active: false, pointerId: null, startX: 0, lastX: 0, lastT: 0, moved: false, baseOffset: 0 };
      function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
      let cards = ITEMS.map(function (item, i) {
        let el = document.createElement('article'); el.className = 'card'; el.style.zIndex = String(10 + i);
        let inner = document.createElement('div'); inner.className = 'card-img'; inner.style.backgroundImage = 'url("' + item.src + '")';
        let hoverSrc = item.src.replace(/\.(jpg|jpeg|png)$/i, '.webp'); let hoverEl = document.createElement('img'); hoverEl.className = 'hover-anim'; hoverEl.src = hoverSrc; hoverEl.loading = 'lazy'; hoverEl.alt = ''; 
        hoverEl.onerror = function() { this.style.display = 'none'; };
        inner.appendChild(hoverEl); el.appendChild(inner); stack.appendChild(el);
        return { el: el, src: item.src, webp: hoverSrc, x: 0, y: 0, s: 1, vx: 0, vy: 0, vs: 0, tx: 0, ty: 0, ts: 1, isActive: false };
      });
      function getScaleFactor() { let currentHeight = stage.clientHeight || window.innerHeight * 0.6; return currentHeight / 665; }
      function cardSize() { return stage.clientHeight || window.innerHeight * 0.6; }
      function cardWidth() { return cardSize() * (968 / 665); }
      function getGap() { return 10 * getScaleFactor(); }
      function getTotalWidth() { let total = 0, gap = getGap(); cards.forEach(() => total += cardWidth() + gap); return total - gap; }
      function computeTargets() {
        let size = cardSize(); let gap = getGap(); let currentX = mobileOffset; let centerY = 0; 
        cards.forEach(function (card, i) {
          let width = cardWidth(); card.el.style.width = width + 'px'; card.el.style.height = size + 'px'; card.tx = currentX; card.ty = centerY; card.ts = 1;
          let isHovered = (active === i && pointer.inside); if (isHovered) { card.ts = 1.01; }
          if (isHovered !== card.isActive) { card.isActive = isHovered; if (isHovered) card.el.classList.add('is-active'); else card.el.classList.remove('is-active'); }
          currentX += width + gap;
        });
      }
      function activeFromPointer(clientX, clientY) {
        let stageRect = stage.getBoundingClientRect(); let localX = clientX - stageRect.left; let localY = clientY - stageRect.top;
        for (let i = cards.length - 1; i >= 0; i--) { let w = cardWidth(), h = cardSize(); let left = cards[i].x, top = cards[i].y; if (localX >= left && localX <= left + w && localY >= top && localY <= top + h) { return i; } }
        return -1;
      }
      function stepSpring(card, prop, target, velocity, dt, stiffness, damping) { let displacement = card[target] - card[prop]; card[velocity] += displacement * stiffness * dt; card[velocity] *= Math.pow(damping, dt); card[prop] += card[velocity] * dt; }
      function render(now) {
        let dt = clamp((now - lastTime) / 16.6667, .5, 2.15); lastTime = now;
        if (!drag.active) { let vHolder = { v: mobileVelocity }; let displacement = mobileTargetOffset - mobileOffset; vHolder.v += displacement * 0.082 * dt; vHolder.v *= Math.pow(0.735, dt); mobileOffset += vHolder.v * dt; mobileVelocity = vHolder.v; }
        computeTargets();
        cards.forEach(function (card, i) {
          if (reduceMotion) { card.x = card.tx; card.y = card.ty; card.s = card.ts; } else { let delayFeel = 1 - Math.min(i, 18) * .005; stepSpring(card, 'x', 'tx', 'vx', dt, SETTINGS.spring.xStiffness * delayFeel, SETTINGS.spring.xDamping); stepSpring(card, 'y', 'ty', 'vy', dt, SETTINGS.spring.yStiffness * delayFeel, SETTINGS.spring.yDamping); stepSpring(card, 's', 'ts', 'vs', dt, SETTINGS.spring.scaleStiffness, SETTINGS.spring.scaleDamping); }
          card.el.style.transform = `translate(${card.x.toFixed(3)}px, ${card.y.toFixed(3)}px) scale(${card.s.toFixed(4)})`;
        });
        requestAnimationFrame(render);
      }
      function getCardStartRect(card) { let stageRect = stage.getBoundingClientRect(); let baseW = cardWidth(), baseH = cardSize(); let w = baseW * card.s, h = baseH * card.s; let cx = stageRect.left + card.x + baseW / 2, cy = stageRect.top + card.y + baseH / 2; return { left: cx - w / 2, top: cy - h / 2, width: w, height: h }; }
      function getFullscreenRect() { let vw = window.innerWidth, vh = window.innerHeight; let maxW = vw * 0.88, maxH = vh * 0.88; let width = maxW, height = width / (968 / 665); if (height > maxH) { height = maxH; width = height * (968 / 665); } return { left: (vw - width) / 2, top: (vh - height) / 2, width: width, height: height }; }
      function openCard(index) {
        if (modal.open || modal.animating) return; let card = cards[index]; let start = getCardStartRect(card); let target = getFullscreenRect();
        modal.open = true; modal.animating = true; modal.index = index; pointer.inside = false; active = -1;
        let overlay = document.createElement('div'); overlay.className = 'gallery-overlay'; let clone = document.createElement('div'); clone.className = 'gallery-clone'; let cloneImg = document.createElement('div'); cloneImg.className = 'card-img'; let modalImg = document.createElement('img'); modalImg.src = card.webp; modalImg.style.width = '100%'; modalImg.style.height = '100%'; modalImg.style.objectFit = 'cover'; modalImg.style.borderRadius = 'inherit';
        modalImg.onerror = function() { this.src = card.src; };
        cloneImg.appendChild(modalImg); clone.appendChild(cloneImg); let closeBtn = document.createElement('button'); closeBtn.className = 'gallery-close'; closeBtn.innerHTML = '&times;';
        document.body.appendChild(overlay); document.body.appendChild(clone); document.body.appendChild(closeBtn); document.body.classList.add('modal-open');
        modal.overlay = overlay; modal.clone = clone; modal.closeBtn = closeBtn; modal.hiddenCard = card.el;
        clone.style.left = start.left + 'px'; clone.style.top = start.top + 'px'; clone.style.width = start.width + 'px'; clone.style.height = start.height + 'px'; card.el.style.opacity = '0'; 
        overlay.addEventListener('click', closeCard); clone.addEventListener('click', closeCard); closeBtn.addEventListener('click', closeCard);
        overlay.animate([{ opacity: '0' }, { opacity: '1' }], { duration: 300, fill: 'forwards' }); closeBtn.animate([{ opacity: '0', transform: 'scale(.8)' }, { opacity: '1', transform: 'scale(1)' }], { duration: 300, delay: 200, fill: 'forwards' });
        let anim = clone.animate([ { left: start.left + 'px', top: start.top + 'px', width: start.width + 'px', height: start.height + 'px' }, { left: target.left + 'px', top: target.top + 'px', width: target.width + 'px', height: target.height + 'px' } ], { duration: 600, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'forwards' });
        anim.onfinish = function() { modal.animating = false; };
      }
      function closeCard() {
        if (!modal.open || modal.animating) return; modal.animating = true; let card = cards[modal.index]; let end = getCardStartRect(card); let current = modal.clone.getBoundingClientRect();
        modal.overlay.animate([{ opacity: '1' }, { opacity: '0' }], { duration: 300, fill: 'forwards' }); modal.closeBtn.animate([{ opacity: '1', transform: 'scale(1)' }, { opacity: '0', transform: 'scale(.8)' }], { duration: 200, fill: 'forwards' });
        let anim = modal.clone.animate([ { left: current.left + 'px', top: current.top + 'px', width: current.width + 'px', height: current.height + 'px' }, { left: end.left + 'px', top: end.top + 'px', width: end.width + 'px', height: end.height + 'px' } ], { duration: 500, easing: 'cubic-bezier(.3,0,.2,1)', fill: 'forwards' });
        anim.onfinish = function() { card.el.style.opacity = '1'; [modal.overlay, modal.clone, modal.closeBtn].forEach(n => n.parentNode.removeChild(n)); document.body.classList.remove('modal-open'); modal.open = false; modal.animating = false; modal.index = -1; };
      }
      hitLayer.addEventListener('pointerenter', () => { if(!modal.open) pointer.inside = true; }); hitLayer.addEventListener('pointermove', e => { if(modal.open || drag.active) return; pointer.inside = true; active = activeFromPointer(e.clientX, e.clientY); }); hitLayer.addEventListener('pointerleave', () => { pointer.inside = false; active = -1; });
      hitLayer.addEventListener('pointerdown', e => { if (modal.open || (e.button != null && e.button !== 0)) return; drag.active = true; drag.pointerId = e.pointerId; drag.startX = drag.lastX = e.clientX; drag.lastT = performance.now(); drag.moved = false; drag.baseOffset = mobileOffset; hitLayer.classList.add('is-dragging'); try { hitLayer.setPointerCapture(e.pointerId); } catch (e) {} });
      hitLayer.addEventListener('pointermove', e => { if (!drag.active) return; let dx = e.clientX - drag.startX; let now = performance.now(), dt = Math.max(1, now - drag.lastT); mobileVelocity = (e.clientX - drag.lastX) / dt * 16; drag.lastX = e.clientX; drag.lastT = now; if (Math.abs(dx) > 5) drag.moved = true; let minOffset = Math.min(0, stage.clientWidth - getTotalWidth()); let nextOffset = drag.baseOffset + dx; if (nextOffset > 0) nextOffset = nextOffset * 0.3; if (nextOffset < minOffset) nextOffset = minOffset + (nextOffset - minOffset) * 0.3; mobileOffset = mobileTargetOffset = nextOffset; });
      function finishDrag(e) { if (!drag.active) return; hitLayer.classList.remove('is-dragging'); try { hitLayer.releasePointerCapture(drag.pointerId); } catch (e) {} drag.active = false; let minOffset = Math.min(0, stage.clientWidth - getTotalWidth()); mobileTargetOffset = mobileOffset + mobileVelocity * 8; mobileTargetOffset = clamp(mobileTargetOffset, minOffset, 0); if (!drag.moved) { let tapIndex = activeFromPointer(e.clientX, e.clientY); if (tapIndex >= 0) openCard(tapIndex); } }
      hitLayer.addEventListener('pointerup', finishDrag); hitLayer.addEventListener('pointercancel', finishDrag);
      window.addEventListener('wheel', e => { if (modal.open || drag.active) return; let delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY; if (Math.abs(delta) < 1) return; e.preventDefault(); let minOffset = Math.min(0, stage.clientWidth - getTotalWidth()); mobileTargetOffset -= delta * SETTINGS.desktopWheelSensitivity; mobileTargetOffset = clamp(mobileTargetOffset, minOffset, 0); }, { passive: false });
      window.addEventListener('resize', () => { computeTargets(); let minOffset = Math.min(0, stage.clientWidth - getTotalWidth()); mobileTargetOffset = clamp(mobileTargetOffset, minOffset, 0); });
      document.documentElement.classList.add('ui-ready'); requestAnimationFrame(render);
    }
  })();
</script>