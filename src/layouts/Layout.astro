---
// Подключаем наш файл со стилями
import '../styles/global.css';

const { title = 'Дизайнер Марк Пурель', description = 'Полный цикл разработки: UX/UI, 3D, Motion' } = Astro.props;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<!-- Базовое SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	
	<!-- font-onest теперь берется из настроек @theme в global.css -->
	<body class="bg-[#050505] text-neutral-300 antialiased font-onest selection:bg-neutral-800 selection:text-white">
		<slot />
	</body>
</html>