---
// Подключаем наш файл со стилями Tailwind
import '../styles/global.css';

// Позволяем передавать title для каждой страницы индивидуально
const { title = 'Портфолио | Mark Pourel', description = 'Сайт-портфолио' } = Astro.props;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<!-- Базовое SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	
	<!-- Базовые классы Tailwind: задаем цвет фона, цвет текста и сглаживание шрифтов -->
	<body class="bg-[#050505] text-neutral-300 antialiased selection:bg-neutral-800 selection:text-white">
		<slot />
	</body>
</html>