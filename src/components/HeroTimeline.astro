---
// src/components/HeroTimeline.astro
const years = ['2008', '2010', '2012', '2014', '2018', '2023', '2026'];
const totalTicks = 25; // Количество вертикальных рисок
---
<div class="anim-timeline w-full max-w-2xl mx-auto px-6 mb-8 z-10 flex flex-col gap-2 pointer-events-none">
  
  <!-- Года (Labels) -->
  <div class="flex justify-between text-[11px] text-white/50 font-medium px-1">
    {years.map(year => (
      <span>{year}</span>
    ))}
  </div>

  <!-- Сам трек с ползунком -->
  <div class="relative h-6 flex items-center w-full">
    
    <!-- Риски (Ticks) -->
    <div class="absolute inset-0 flex justify-between items-center px-1 opacity-40">
      {Array.from({ length: totalTicks }).map(() => (
        <div class="w-[1px] h-2 bg-white"></div>
      ))}
    </div>

    <!-- Заполненная часть (Градиент) -->
    <div 
      class="timeline-fill absolute left-0 top-1/2 -translate-y-1/2 h-2 bg-gradient-to-r from-transparent via-[#ff7b00]/80 to-[#ff7b00] w-0 z-10 mix-blend-screen"
    ></div>

    <!-- Ползунок (Светящийся ромб) -->
    <div 
      class="timeline-thumb absolute left-0 top-1/2 -translate-y-1/2 w-[10px] h-[10px] bg-white z-20 shadow-[0_0_15px_6px_rgba(255,123,0,0.8)] rounded-[1px]" 
      style="transform: translateY(-50%) rotate(45deg); margin-left: -5px;"
    ></div>
    
  </div>
</div>