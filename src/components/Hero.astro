---
// src/components/Hero.astro
import HeroHeader from './HeroHeader.astro';
import HeroDescription from './HeroDescription.astro';

// Автоматический импорт видео из папки src/assets/video/
const videoFiles = import.meta.glob<{ default: string }>('/src/assets/video/*.{mp4,webm}', { eager: true });
const videoEntry = Object.values(videoFiles)[0];
const videoUrl = videoEntry ? videoEntry.default : '/video/bg.webm';
---
<section class="relative flex w-full h-dvh flex-col justify-between items-center overflow-hidden box-border">
  
  <!-- Зацикленное видео на весь экран с адаптивным покрытием -->
  <video 
    src={videoUrl} 
    autoplay 
    loop 
    muted 
    playsinline 
    class="anim-render absolute inset-0 w-full h-full object-cover z-0 will-change-transform"
  ></video>

  <!-- Верхняя шапка -->
  <HeroHeader />

  <!-- Центральная часть: Заголовок поверх видео -->
  <div class="relative w-full flex-1 flex justify-center items-center pointer-events-none z-10">
    <!-- Используем созданный адаптивный класс -->
    <h1 class="anim-title typing-title text-center text-white text-hero-name">
      Марк Пурель
    </h1>
  </div>

  <!-- Нижний блок с аватаром -->
  <HeroDescription />

</section>