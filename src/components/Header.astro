---
---
<!-- Убрал лишние отступы, добавил flex-nowrap, чтобы не переносилось -->
<header class="flex flex-row flex-nowrap justify-between items-center w-full h-[32px] shrink-0">
  
  <!-- Logo + Title (фиксированная ширина) -->
  <div class="flex flex-row items-center gap-[8px] w-[139px] h-[32px] shrink-0">
    <!-- Логотип 32x32 -->
    <a href="/" class="block w-[32px] h-[32px] rounded-[8px] overflow-hidden shrink-0">
      <img src="/icons/logo.svg" alt="Logo" class="w-full h-full object-cover" />
    </a>
    
    <!-- Title -->
    <div class="flex flex-col items-start gap-[2px] h-[28px] whitespace-nowrap overflow-visible">
      <span class="block font-['Fixel_Display'] font-semibold text-[10px] leading-[100%] tracking-[-0.03em] text-white opacity-50 uppercase">Диджитал-дизайнер</span>
      <span class="block font-['Fixel_Display'] font-medium text-[16px] leading-[100%] tracking-[-0.04em] text-white">Марк Пурель</span>
    </div>
  </div>

  <!-- Меню -->
  <nav class="flex flex-row flex-nowrap items-center gap-[6px] h-[32px]">
    <a href="#cases" class="flex justify-center items-center px-[12px] py-[6px] h-[32px] border border-white/10 rounded-[8px] whitespace-nowrap hover:bg-white/5 transition-colors">
      <span class="font-['Fixel_Display'] font-semibold text-[14px] leading-[130%] tracking-[-0.04em] text-white opacity-50">Кейсы</span>
    </a>
    <a href="#skills" class="flex justify-center items-center px-[12px] py-[6px] h-[32px] border border-white/10 rounded-[8px] whitespace-nowrap hover:bg-white/5 transition-colors">
      <span class="font-['Fixel_Display'] font-semibold text-[14px] leading-[130%] tracking-[-0.04em] text-white opacity-50">Навыки</span>
    </a>
    <a href="#experience" class="flex justify-center items-center px-[12px] py-[6px] h-[32px] border border-white/10 rounded-[8px] whitespace-nowrap hover:bg-white/5 transition-colors">
      <span class="font-['Fixel_Display'] font-semibold text-[14px] leading-[130%] tracking-[-0.04em] text-white opacity-50">Опыт</span>
    </a>
  </nav>

  <!-- Lang + Button -->
  <div class="flex flex-row flex-nowrap items-center gap-[6px] h-[32px] shrink-0">
    <div class="flex flex-row items-center p-[4px] gap-[2px] bg-[#171717] rounded-[8px]">
      <button class="flex justify-center items-center w-[27px] h-[24px] bg-[#262626] border border-white/5 rounded-[5px]">
        <span class="font-['Fixel_Display'] font-bold text-[12px] leading-[130%] tracking-[-0.05em] text-white opacity-90">RU</span>
      </button>
      <button class="flex justify-center items-center w-[27px] h-[24px] rounded-[5px] hover:bg-white/5">
        <span class="font-['Fixel_Display'] font-bold text-[12px] leading-[130%] tracking-[-0.05em] text-white opacity-60">EN</span>
      </button>
    </div>
    <a href="#contacts" class="flex justify-center items-center px-[12px] py-[6px] h-[32px] bg-[#171717] rounded-[8px] whitespace-nowrap hover:bg-[#262626] transition-colors">
      <span class="font-['Fixel_Display'] font-semibold text-[14px] leading-[130%] tracking-[-0.05em] text-white opacity-90">Связаться</span>
    </a>
  </div>
</header>