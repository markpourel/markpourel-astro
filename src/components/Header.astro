---
---
<header class="flex flex-col md:flex-row justify-between items-center w-full min-h-[32px] gap-4 md:gap-0 shrink-0">
  
  <div class="flex flex-row items-center gap-[8px] w-full md:w-[139px] justify-center md:justify-start shrink-0">
    <a href="/" class="block w-[32px] h-[32px] rounded-[8px] overflow-hidden shrink-0">
      <img src="/icons/logo.svg" alt="Logo" class="w-full h-full object-cover" />
    </a>
    
    <div class="flex flex-col items-start gap-[2px] h-[28px] whitespace-nowrap overflow-visible">
      <!-- Использован семантический класс text-label-sm и убран uppercase -->
      <span class="block text-label-sm text-white opacity-50">Диджитал-дизайнер</span>
      <span class="block font-fixel font-medium text-[16px] leading-[100%] tracking-[-0.04em] text-white">Марк Пурель</span>
    </div>
  </div>

  <nav class="flex flex-row flex-wrap justify-center items-center gap-[6px] min-h-[32px]">
    <!-- Использован семантический класс text-ui-btn -->
    <a href="#cases" class="flex justify-center items-center px-[12px] py-[6px] h-[32px] border border-white/10 rounded-[8px] whitespace-nowrap hover:bg-white/5 transition-colors">
      <span class="text-ui-btn text-white opacity-50">Кейсы</span>
    </a>
    <a href="#skills" class="flex justify-center items-center px-[12px] py-[6px] h-[32px] border border-white/10 rounded-[8px] whitespace-nowrap hover:bg-white/5 transition-colors">
      <span class="text-ui-btn text-white opacity-50">Навыки</span>
    </a>
    <a href="#experience" class="flex justify-center items-center px-[12px] py-[6px] h-[32px] border border-white/10 rounded-[8px] whitespace-nowrap hover:bg-white/5 transition-colors">
      <span class="text-ui-btn text-white opacity-50">Опыт</span>
    </a>
  </nav>

  <div class="flex flex-row items-center justify-center md:justify-end gap-[6px] min-h-[32px] shrink-0">
    <div class="flex flex-row items-center p-[4px] gap-[2px] bg-[#171717] rounded-[8px]">
      <!-- Использован text-caption с переопределением толщины font-bold -->
      <button class="flex justify-center items-center w-[27px] h-[24px] bg-[#262626] border border-white/5 rounded-[5px]">
        <span class="text-caption font-bold text-white opacity-90">RU</span>
      </button>
      <button class="flex justify-center items-center w-[27px] h-[24px] rounded-[5px] hover:bg-white/5">
        <span class="text-caption font-bold text-white opacity-60">EN</span>
      </button>
    </div>
    <a href="#contacts" class="flex justify-center items-center px-[12px] py-[6px] h-[32px] bg-[#171717] rounded-[8px] whitespace-nowrap hover:bg-[#262626] transition-colors">
      <span class="text-ui-btn text-white opacity-90">Связаться</span>
    </a>
  </div>
</header>