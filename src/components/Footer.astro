---
import { Image } from 'astro:assets';
import profileImg from '../assets/profile/profile.jpg';

const skills = [
  { src: '/icons/figma.svg', label: 'Figma' },
  { src: '/icons/tilda.svg', label: 'Tilda' },
  { src: '/icons/photoshop.svg', label: 'Photoshop' },
  { src: '/icons/illustrator.svg', label: 'Illustrator' },
  { src: '/icons/after.svg', label: 'After Effects' },
  { src: '/icons/3dsmax.svg', label: '3dsMax' },
  { src: '/icons/redshift.svg', label: 'Redshift' },
  { src: '/icons/comfy.svg', label: 'ComfyUI' },
  { src: '/icons/flow.svg', label: 'Google Flow' }
];
---

<footer class="flex flex-col xl:flex-row justify-between items-start xl:items-center w-full min-h-[255px] h-auto shrink-0 gap-[32px] xl:gap-[10px] min-w-0">
  
  <!-- ПРОФИЛЬ -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-[32px] xl:h-[255px] flex-1 w-full xl:max-w-[640px] min-w-0">
    <div class="w-[192px] h-[255px] rounded-[12px] overflow-hidden shrink-0 bg-[#1A1A1A]">
      <Image src={profileImg} alt="Марк Пурель" class="w-full h-full object-cover" />
    </div>
    <div class="flex flex-col justify-center items-start gap-[16px] flex-1 min-w-0 xl:h-[255px]">
      <h2 class="text-h1 text-white truncate w-full">Диджитал-дизайнер</h2>
      <p class="text-body-md text-white opacity-80 sm:line-clamp-3">Я - Марк. Закрываю полный цикл разработки: UX/UI, 3D, моушн и AI, создавая качественные цифровые решения на стыке технологий и визуального сторителлинга.</p>
      
      <div class="box-border flex flex-row flex-wrap items-center p-[4px] gap-[2px] bg-[#171717] rounded-[8px] shrink-0">
        <a href="#" class="box-border flex flex-row items-center px-[6px] gap-[4px] h-[25px] bg-[#262626] border border-white/15 rounded-[5px] transition-colors hover:bg-neutral-700">
          <div class="w-[14px] h-[11.6px] bg-[#E9E9E9] opacity-50"></div>
          <span class="text-caption text-white opacity-40">Telegram</span>
        </a>
        <a href="#" class="box-border flex flex-row items-center px-[6px] gap-[4px] h-[25px] bg-[#262626] border border-white/15 rounded-[5px] transition-colors hover:bg-neutral-700">
          <div class="w-[16px] h-[10.11px] bg-[#E9E9E9] opacity-50"></div>
          <span class="text-caption text-white opacity-40">Behance</span>
        </a>
        <a href="#" class="box-border flex flex-row items-center px-[6px] gap-[4px] h-[25px] bg-[#262626] border border-white/15 rounded-[5px] transition-colors hover:bg-neutral-700">
          <div class="w-[15px] h-[14.98px] bg-[#E9E9E9] opacity-50"></div>
          <span class="text-caption text-white opacity-40">Dribbble</span>
        </a>
      </div>
    </div>
  </div>

 <!-- Секция Skills: Grid вместо Flex для автоматического перестроения колонок -->
<div class="grid grid-cols-[repeat(auto-fill,minmax(117px,1fr))] gap-[32px] w-full max-w-[440px] min-w-[355px] h-auto">
  {skills.map(item => (
    <div class="skill-card">
      <div class="skill-icon-box">
         <img src={item.src} alt={item.label} class="w-[24px] h-[24px] object-contain" />
      </div>
      <span class="text-caption text-white opacity-40 whitespace-nowrap truncate">{item.label}</span>
    </div>
  ))}
</div>

  <!-- BENTO GRID -->
  <div class="hidden xl:flex flex-row gap-[6px] w-[372px] h-[255px] shrink-0">
    <div class="flex flex-col gap-[6px] w-[215px] h-[255px]">
      <div class="flex gap-[6px] w-[215px] h-[64px]">
        <div class="box-border flex flex-col p-[4px] w-[104.5px] h-[64px] bg-white/15 border border-white/15 rounded-[12px]"><div class="w-full h-full rounded-[8px] bg-[#1A1A1A]"></div></div>
        <div class="box-border flex flex-col p-[4px] w-[104.5px] h-[64px] bg-white/15 border border-white/15 rounded-[12px]"><div class="w-full h-full rounded-[8px] bg-[#1A1A1A]"></div></div>
      </div>
      <div class="box-border flex flex-col p-[4px] w-[215px] h-[185px] bg-white/15 border border-white/15 rounded-[12px]"><div class="w-full h-full rounded-[8px] bg-[#1A1A1A]"></div></div>
    </div>
    <div class="flex flex-col gap-[6px] w-[151px] h-[255px]">
      <div class="box-border flex flex-col p-[4px] w-[151px] h-[185px] bg-white/15 border border-white/15 rounded-[12px]"><div class="w-full h-full rounded-[8px] bg-[#1A1A1A]"></div></div>
      <div class="box-border flex flex-col p-[4px] w-[151px] h-[64px] bg-white/15 border border-white/15 rounded-[12px]"><div class="w-full h-full rounded-[8px] bg-[#1A1A1A]"></div></div>
    </div>
  </div>
</footer>