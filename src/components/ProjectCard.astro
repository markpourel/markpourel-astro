---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  index: number;
  videoUrl: string; // Добавляем пропс для видео
}

const { src, alt, index, videoUrl } = Astro.props;
---

<article 
  class="card group absolute left-0 top-0 bg-[#000000] rounded-[8px] box-border cursor-pointer pointer-events-none will-change-transform origin-center" 
  style={`z-index: ${10 + index};`} 
  data-src={src.src}
  data-video={videoUrl}
>
  <div class="card-img w-full h-full rounded-[8px] relative overflow-hidden">
    <!-- Изображение выводится без дополнительных визуальных фильтров -->
    <Image 
      src={src} 
      alt={alt} 
      class="w-full h-full object-cover absolute inset-0 transition-opacity duration-1200 opacity-100 group-[.is-active]:opacity-0" 
      loading={index < 4 ? "eager" : "lazy"} 
    />
    <!-- Видео с SEO и Performance атрибутами -->
    <video 
      src={videoUrl}
      poster={src.src}
      class="w-full h-full object-cover absolute inset-0 transition-opacity duration-1200 opacity-0 group-[.is-active]:opacity-100"
      muted 
      playsinline 
      loop 
      preload="none"
    ></video>
  </div>
</article>